  "correctness": {
    "command": [
      "python3",
      "/scratch/codex-serve-sweep/sanity.py",
      "{endpoint}",
      "/scratch/models/GLM-5-1028-Provider",
      "{candidate_dir}/correctness.json"
    ],
    "gates": {
      "empty_rate": {
        "max": 0
      },
      "error_rate": {
        "max": 0
      },
      "stop_rate": {
        "min": 1
      }
    },
    "metrics_path": "{candidate_dir}/correctness.json",
    "timeout_s": 600
  },
  "env": {
    "PYTHONPATH": "/scratch/cc-regate2/overlay:/scratch/cc-swa/fi073:/scratch/kimi-glm42-repro/packages:/scratch/codex-serve-sweep/src/python",
    "SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND": "python"
  },
  "load": {
    "command": [
      "python3",
      "/scratch/codex-serve-sweep/load_adapter.py",
      "{endpoint}",
      "/scratch/models/GLM-5-1028-Provider",
      "{level}",
      "{repeat}",
      "{summary_path}"
    ],
    "gates": {
      "empty_rate": {
        "max": 0
      },
      "interactivity_p90": {
        "min": 30
      },
      "ok_ratio": {
        "min": 1
      },
      "ttft_p90": {
        "max": 3
      }
    },
    "levels": [
      1,
      2,
      4,
      8
    ],
    "mode": "closed_loop",
    "repeat": 2,
    "selection": {
      "interactivity_metric": "interactivity_p90",
      "interactivity_min": 30,
      "latency_metric": "ttft_p50",
      "near_tie_pct": 2,
      "per_user_metric": "interactivity_p90",
      "throughput_metric": "total_tps_per_gpu"
    },
    "sum_metrics": [
      "sent",
      "ok",
      "errors",
      "empty_responses",
      "input",
      "output",
      "cached"
    ],
    "timeout_s": 1200
  },
  "preflight": {
    "check_gpus": true,
    "gpus": [
      0,
      1,
      2,
      3
    ],
    "max_memory_mib": 1000
  },
  "record_env_keys": [
    "PYTHONPATH",
    "CUDA_VISIBLE_DEVICES",
    "SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND"
  ],
  "server": {
    "args": [
      "--model-path",
