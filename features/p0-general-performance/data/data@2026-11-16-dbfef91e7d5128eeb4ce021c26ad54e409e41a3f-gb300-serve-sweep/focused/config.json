      "glm45",
      "--tool-call-parser",
      "glm47",
      "--enable-cache-report",
      "--enable-metrics"
    ],
    "command": [
      "python3",
      "-m",
      "sglang.launch_server"
    ],
    "cwd": "/scratch/codex-serve-sweep/src",
