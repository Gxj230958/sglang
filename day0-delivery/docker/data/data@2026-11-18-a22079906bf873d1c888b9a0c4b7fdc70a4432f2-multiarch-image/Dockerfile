# syntax=docker/dockerfile:1
#
# GLM-5-loop 1118 cutoff image: upstream nightly + cutoff source tree + rebuilt
# Rust extensions + sgl-deep-gemm with the MegaMoE FP8 TRT-LLM weight-layout patch.
#
# Build context (this directory):
#   sglang-src.tar.gz              git archive of CUTOFF_COMMIT
#   manifest/                      generated by make-manifest.sh
#   verify-source.sh

# Multi-arch index digest of lmsysorg/sglang:nightly-dev-cu13-20261115-7b5fb39b
ARG BASE_IMAGE=lmsysorg/sglang@sha256:b7306e5396c7b5f09cbbbfd714eb03ecfc5908be2188d1ebfddb40857643200f

########################################################
# sgl-deep-gemm wheel (DeepGEMM v0.2.8 + cutoff patch)
########################################################
FROM ${BASE_IMAGE} AS deepgemm_wheel

ARG DEEPGEMM_REF=v0.2.8
ARG DEEPGEMM_COMMIT=e3f6b84093dab1213f50cd1865d847365697ef23
ARG SGL_DEEP_GEMM_VERSION=0.2.8
ARG DEEPGEMM_LOCAL_TAG=cu130.megamoefp8
ARG TVM_FFI_VERSION=0.1.11

# DeepJIT's exception handling needs elfutils/libdwfl.h and libelf headers.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libdw-dev libelf-dev \
    && rm -rf /var/lib/apt/lists/*

RUN test "$(python -c 'import importlib.metadata as m; print(m.version("apache-tvm-ffi"))')" = "${TVM_FFI_VERSION}"

ADD sglang-src.tar.gz /cutoff-src

RUN set -eux; \
    git clone --recursive --depth 1 --branch "${DEEPGEMM_REF}" \
        https://github.com/sgl-project/DeepGEMM.git /deepgemm; \
    test "$(git -C /deepgemm rev-parse HEAD)" = "${DEEPGEMM_COMMIT}"; \
    cd /deepgemm; \
    for p in /cutoff-src/docker/patches/deep_gemm/*.patch; do git apply "$p"; done

RUN set -eux; \
    cd /deepgemm; \
    printf '%s' "${SGL_DEEP_GEMM_VERSION}" > sgl_deep_gemm/VERSION; \
    bash build_sgl_deep_gemm.sh; \
    bash /cutoff-src/scripts/rename_sgl_deep_gemm_whl.sh dist "${DEEPGEMM_LOCAL_TAG}" "$(uname -m)"; \
    mkdir -p /wheels && cp dist/*.whl /wheels/; \
    ls -la /wheels

########################################################
# Final image
########################################################
FROM ${BASE_IMAGE} AS final

ARG BASE_SGLANG_COMMIT=7b5fb39bb952da5f6da3bb7fe73c671cf449b6fa
ARG CUTOFF_COMMIT=a22079906bf873d1c888b9a0c4b7fdc70a4432f2
ARG SGLANG_VERSION=0.0.0.dev1+ga22079906b

COPY sglang-src.tar.gz verify-source.sh /sgl-workspace/glm-loop-1118/
COPY manifest/ /sgl-workspace/glm-loop-1118/manifest/

# Turn the base checkout into the cutoff tree: drop the files only the base
# commit has, then extract every file that differs. Build outputs the base
# image keeps inside the tree are untracked and stay in place.
RUN set -eux; \
    M=/sgl-workspace/glm-loop-1118; \
    cd /sgl-workspace/sglang; \
    test "$(git rev-parse HEAD)" = "${BASE_SGLANG_COMMIT}"; \
    test -z "$(git status --porcelain)"; \
    xargs -d '\n' -a "$M/manifest/base-only-files.txt" rm -f --; \
    tar -xzf "$M/sglang-src.tar.gz" --no-same-owner --no-same-permissions \
        --verbatim-files-from -T "$M/manifest/changed-files.txt"; \
    rm -rf .git rust/target rust/sglang-radix-tree/target; \
    rm -f "$M/sglang-src.tar.gz"; \
    echo "${CUTOFF_COMMIT}" > /sgl-workspace/sglang.commit

# Rebuild every Rust extension from the cutoff sources, the way docker/Dockerfile
# installs them (editable install through setuptools-rust). The old modules are
# removed first so a skipped build cannot leave a base-commit binary behind.
RUN set -eux; \
    cd /sgl-workspace/sglang; \
    rm -f python/sglang/srt/rust_extensions/_*.so \
          python/sglang/srt/mem_cache/rust_tree_core/mem_cache.*.so; \
    export CARGO_TARGET_DIR=/tmp/rust-target \
           SETUPTOOLS_SCM_PRETEND_VERSION="${SGLANG_VERSION}" \
           SETUPTOOLS_SCM_PRETEND_VERSION_FOR_SGLANG="${SGLANG_VERSION}"; \
    uv pip install --no-deps -e "python[all]"; \
    rm -rf /tmp/rust-target /root/.cache/uv; \
    ls -la python/sglang/srt/rust_extensions/ python/sglang/srt/mem_cache/rust_tree_core/; \
    test "$(ls python/sglang/srt/rust_extensions/_*.so | wc -l)" -eq 4; \
    test "$(ls python/sglang/srt/mem_cache/rust_tree_core/mem_cache.*.so | wc -l)" -eq 1; \
    test "$(python -c 'import importlib.metadata as m; print(m.version("sglang"))')" = "${SGLANG_VERSION}"

RUN --mount=type=bind,from=deepgemm_wheel,source=/wheels,target=/wheels \
    set -eux; \
    uv pip install --no-deps --reinstall /wheels/sgl_deep_gemm-*.whl; \
    rm -rf /root/.cache/uv; \
    grep -q "FP8 x FP8 MMA" /opt/sglang/lib/python3.12/site-packages/deep_gemm/mega/__init__.py

RUN set -eux; \
    bash /sgl-workspace/glm-loop-1118/verify-source.sh /sgl-workspace/sglang /sgl-workspace/glm-loop-1118/manifest; \
    PYTHONPYCACHEPREFIX=/tmp/pyc python -m compileall -q /sgl-workspace/sglang/python/sglang; \
    rm -rf /tmp/pyc

WORKDIR /sgl-workspace/sglang

ARG BASE_IMAGE
ARG BASE_PLATFORM_DIGEST=
ARG IMAGE_TAG=xinyuantongradixark/sglang-private:dev-glm-loop-1118
ARG DEEPGEMM_PATCH_SHA256=4e5297071d9488df061b0f850accd2dd326c4006f6eb1f238535fc7020131746
ENV SGLANG_BUILD_COMMIT=${CUTOFF_COMMIT} \
    SGLANG_BUILD_URL= \
    SGLANG_IMAGE_TAG=${IMAGE_TAG}
LABEL org.opencontainers.image.source="https://github.com/radixark/sglang-zai" \
      org.opencontainers.image.revision="${CUTOFF_COMMIT}" \
      org.opencontainers.image.version="${IMAGE_TAG}" \
      org.opencontainers.image.url="" \
      ai.sglang.build.commit="${CUTOFF_COMMIT}" \
      ai.sglang.build.url="" \
      ai.sglang.image.tag="${IMAGE_TAG}" \
      ai.radixark.base.image="lmsysorg/sglang:nightly-dev-cu13-20261115-7b5fb39b" \
      ai.radixark.base.digest="${BASE_IMAGE}" \
      ai.radixark.base.platform_digest="${BASE_PLATFORM_DIGEST}" \
      ai.radixark.base.sglang_commit="${BASE_SGLANG_COMMIT}" \
      ai.radixark.sglang.cutoff_commit="${CUTOFF_COMMIT}" \
      ai.radixark.sglang.upstream_merge_base="6de483b326c7dd4145fde06afcac9866bf491024" \
      ai.radixark.deep_gemm.ref="sgl-project/DeepGEMM v0.2.8 (e3f6b84093dab1213f50cd1865d847365697ef23)" \
      ai.radixark.deep_gemm.patch="docker/patches/deep_gemm/0001-mega-moe-fp8-trtllm-weight-layout.patch sha256:${DEEPGEMM_PATCH_SHA256}" \
      ai.radixark.deep_gemm.version="0.2.8+cu130.megamoefp8"
